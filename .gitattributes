* text=auto eol=lf
*.cmd text eol=crlf

# Текст Unity сохраняет построчный diff и GUID references.
*.cs text
*.unity text -filter -merge
*.prefab text -filter -merge
*.meta text -filter -merge
*.asset text=auto -filter -merge
*.mat text -filter -merge
*.controller text -filter -merge
*.overrideController text -filter -merge
*.anim text -filter -merge
*.asmdef text
*.asmref text
*.inputactions text
# .bytes может содержать бинарные данные, даже если Git считает их текстом.
*.bytes -text
*.tgz -text
*.shader text
*.hlsl text
*.shadergraph text
*.shadersubgraph text

# Unity-сериализатор сохраняет пробел после пустого YAML-значения.
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol

# Все ресурсы и внешние сборки хранятся в обычном Git для скачивания ZIP.
*.png -filter -diff -merge -text
*.jpg -filter -diff -merge -text
*.jpeg -filter -diff -merge -text
*.tga -filter -diff -merge -text
*.tif -filter -diff -merge -text
*.tiff -filter -diff -merge -text
*.bmp -filter -diff -merge -text
*.gif -filter -diff -merge -text
*.webp -filter -diff -merge -text
*.hdr -filter -diff -merge -text
*.exr -filter -diff -merge -text
*.psd -filter -diff -merge -text
*.psb -filter -diff -merge -text
*.fbx -filter -diff -merge -text
*.obj -filter -diff -merge -text
*.glb -filter -diff -merge -text
*.gltf -filter -diff -merge -text
*.blend -filter -diff -merge -text
*.wav -filter -diff -merge -text
*.mp3 -filter -diff -merge -text
*.ogg -filter -diff -merge -text
*.aiff -filter -diff -merge -text
*.mp4 -filter -diff -merge -text
*.mov -filter -diff -merge -text
*.webm -filter -diff -merge -text
*.ttf -filter -diff -merge -text
*.otf -filter -diff -merge -text
*.dll -filter -diff -merge -text
*.pdb -filter -diff -merge -text
*.mdb -filter -diff -merge -text
*.so -filter -diff -merge -text
*.dylib -filter -diff -merge -text
*.a -filter -diff -merge -text
*.zip -filter -diff -merge -text
*.7z -filter -diff -merge -text
*.unitypackage -filter -diff -merge -text
*.pdf -filter -diff -merge -text

# Бинарный .asset требует точного path-правила ниже, не wildcard на все .asset.

# Оригиналы поставщика проверяются по SHA-256: checkout сохраняет их байты.
/Assets/ThirdParty/Demigiant/DOTween/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
/Assets/ThirdParty/Demigiant/DOTween/**/*.meta text eol=lf
/Assets/ThirdParty/Demigiant/DOTween/Modules/DOTween.Modules.asmdef text eol=lf

# Импортированные исходники TMP сохраняют формат поставщика.
/Assets/ThirdParty/TextMeshPro/** -whitespace

# Базовая поставка — обычный Git.
/Assets/ThirdParty/Demigiant/DOTween/DOTween.dll -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/DOTween.dll.mdb -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/DOTweenEditor.dll -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/DOTweenEditor.dll.mdb -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/DOTweenUpgradeManager.dll -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/DOTweenUpgradeManager.dll.mdb -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/Imgs/DOTweenIcon.png -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/Imgs/DOTweenMiniIcon.png -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/Imgs/Footer.png -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/Imgs/Footer_dark.png -filter -diff -merge -text
/Assets/ThirdParty/Demigiant/DOTween/Editor/Imgs/Header.jpg -filter -diff -merge -text
/Assets/ThirdParty/TextMeshPro/Fonts/LiberationSans.ttf -filter -diff -merge -text
/Assets/ThirdParty/TextMeshPro/Sprites/EmojiOne.png -filter -diff -merge -text

# NuGet-поставки сохраняют исходные байты для проверки vendor lock.
/Assets/ThirdParty/NuGet/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
/Assets/ThirdParty/NuGet/**/*.meta text eol=lf
